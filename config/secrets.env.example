# Copy to config/secrets.env and chmod 600. Loading refuses anything looser:
# a world-readable secrets file is worse than an environment variable, because
# it looks like protection.
#
# Values are substituted into ${VAR} in the YAML at load time. The camera rows
# keep the un-expanded template, so a password never reaches the database, a log
# line, or a git diff. The environment wins over this file.

# Camera RTSP credentials (ADR-0029: a view-only account per camera)
CAMERA_USER=
CAMERA_PASSWORD=

# ZKTeco badge reader (gate.password)
ZKT_PASSWORD=

# Console role passphrases (ADR-0028). One per tier, and they authenticate a
# ROLE rather than a person -- the actor name in the audit log is typed by
# whoever is sitting there.
UI_VIEWER_PASSPHRASE=
UI_REVIEWER_PASSPHRASE=
UI_PAYROLL_PASSPHRASE=
UI_ADMIN_PASSPHRASE=
